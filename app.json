{
  "expo": {
    "name": "FurrEver",
    "slug": "furrever",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.jpeg",
    "scheme": "furreverexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.furrever.app",
      "infoPlist": {
        "ITSAppUsesNOnExemptEncryption": false,
        "supportsTablet": true
      }
    },
    "splash": {
      "image": "./assets/Logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.furrever.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "./plugins/withAndroidManifest",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notificationIcon.png",
          "color": "#F4A900",
          "sounds": ["./assets/sounds/notifications.wav"],
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0a519bf-7c57-4df8-bb0d-c5e6fef3e107"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "furreversupport"
  }
}
